<section aria-label="댓글" class="comments">
  <h2>댓글</h2>
  <div id="giscus-comments"></div>
  <noscript><p>댓글을 보려면 JavaScript를 켜거나 <a href="https://github.com/jihoon-ernesto/jihoon-ernesto.github.io/discussions">GitHub Discussions</a>를 방문해 주세요.</p></noscript>
</section>
<script>
  // Production domain and local preview both retain the original pathname mapping.
  // No client-side router: each navigation mounts exactly one Giscus iframe.
  const container = document.getElementById('giscus-comments');
  if (container) {
    const script = document.createElement('script');
    script.src = 'https://giscus.app/client.js';
    script.async = true;
    script.crossOrigin = 'anonymous';
    const attributes = {
      'data-repo': 'jihoon-ernesto/jihoon-ernesto.github.io',
      'data-repo-id': 'R_kgDOHJWllw',
      'data-category': 'Announcements',
      'data-category-id': 'DIC_kwDOHJWll84CPG4E',
      'data-mapping': 'pathname',
      'data-reactions-enabled': '1',
      'data-emit-metadata': '0',
      'data-input-position': 'bottom',
      'data-theme': 'light',
      'data-lang': 'en',
      'data-loading': 'lazy',
    };
    for (const [name, value] of Object.entries(attributes)) script.setAttribute(name, value);
    script.onerror = () => {
      const link = document.createElement('a');
      link.href = 'https://github.com/jihoon-ernesto/jihoon-ernesto.github.io/discussions';
      link.textContent = '댓글을 불러오지 못했습니다. GitHub Discussions에서 확인해 주세요.';
      container.appendChild(link);
    };
    container.appendChild(script);
  }
</script>
